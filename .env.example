RATE_LIMIT_GUEST_GENERATE_PER_DAY=6
RATE_LIMIT_USER_GENERATE_PER_HOUR=10
RATE_LIMIT_USER_GENERATE_PER_DAY=30
MAX_TRIPS_PER_USER=50
APP_BASE_URL=http://localhost:5173

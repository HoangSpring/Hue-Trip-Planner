{
  "name": "hue-trip-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "supabase db push --yes",
    "db:seed": "supabase db push --include-seed --yes",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/supabase.ts",
    "db:test:rls": "supabase test db --local supabase/tests"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "hono": "^4.13.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}

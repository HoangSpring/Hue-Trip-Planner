{
  "name": "hue-trip-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx scripts/devApi.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "supabase db push --yes",
    "db:seed": "tsx supabase/seed/importPlaces.ts",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/supabase.ts",
    "db:test:rls": "supabase test db --local supabase/tests",
    "smoke:api": "tsx scripts/smokeApi.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "hono": "^4.13.13",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "leaflet.markercluster": "^1.5.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
